# Contrato de variáveis de ambiente consumidas pelo ConfigManager (K8s).
#
# No cluster, estas variáveis são injetadas pelo manifesto via
#   envFrom:
#     - configMapRef: { name: <configmap> }   # valores não-secretos
#     - secretRef:    { name: <secret> }       # senhas / access keys
#
# A fonte da verdade é _ENV_SCHEMA em src/main/utils/config_manager.py.
# Variável ausente é simplesmente omitida — cada pipeline usa um subconjunto.
# Este arquivo é apenas referência; NÃO versione valores reais de segredo.

# --- MinIO / S3 ---
MINIO_BASE_PATH=s3a://datawake-tenant-uat
SPARK_S3_ENDPOINT=https://minio.datawake.cloud:9000
SPARK_S3_ACCESS_KEY=              # secret
SPARK_S3_SECRET_KEY=              # secret

# --- Postgres (datamart gold) ---
POSTGRES_HOST=dw-prd-postgres.dw-sql.svc.local-k8s.datawake.cloud
POSTGRES_PORT=5432                # coagido para int
POSTGRES_DATABASE=tenant_dw
POSTGRES_USER=etl_admin
POSTGRES_PASSWORD=               # secret
POSTGRES_SCHEMA=public

# --- Trino ---
TRINO_TYPE_AUTH=basic            # basic | oauth2
TRINO_HOST=trino.datawake.cloud
TRINO_PORT=48085                 # coagido para int
TRINO_CATALOG=tenant
TRINO_SCHEMA=business
TRINO_SCHEMA_FOLDER=business_datavault_data-bee
TRINO_SCHEMA_FOLDER_SILVER=business_datavault_data-bee
TRINO_SCHEMA_FOLDER_GOLD=service_data_data-bee
TRINO_VERIFY_SSL=false           # coagido para bool (true/1/yes = True)
TRINO_USER=admin                 # type_auth=basic
TRINO_PASSWORD=                  # secret; type_auth=basic
TRINO_BASE_URL=https://accounts.datawake.cloud:8443/realms/sso-datawake  # type_auth=oauth2
TRINO_CLIENT_ID=                 # type_auth=oauth2
TRINO_CLIENT_SECRET=             # secret; type_auth=oauth2

# --- ClickHouse (logs de auditoria) ---
CLICKHOUSE_URL=https://api-logs.datawake.cloud
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=             # secret
CLICKHOUSE_SERVICE_NAME=spark-into-postgres
CLICKHOUSE_VERIFY_SSL=wildcard_datadriven_cloud.crt  # bool (true/false) OU nome do cert em resources/
